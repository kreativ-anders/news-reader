# Ploi Webserver Configuration, do not remove!
include /etc/nginx/ploi/news-reader.app/before/*;

# -----------------------------------------------------------------------------
# News Reader – language handling
#
# ?lang=… is an explicit choice and never redirected.
# Otherwise use the first supported language from Accept-Language.
# -----------------------------------------------------------------------------

map "$arg_lang:$http_accept_language" $news_reader_thanks_lang {
    default "";
    "~^:(?<nr_thanks_lang>de|fr|it|es)" $nr_thanks_lang;
}

# -----------------------------------------------------------------------------
# Error page in the visitor's language
#
# Language of the address (/de/…), else the first browser language, else
# English. Without error_page nginx shows its own bare 404 page.
# -----------------------------------------------------------------------------

map "$uri:$http_accept_language" $news_reader_404 {
    default /404.html;
    "~^/(?<nr_404_path>de|fr|it|es)/" /$nr_404_path/404.html;
    "~^[^:]*:(?<nr_404_browser>de|fr|it|es)" /$nr_404_browser/404.html;
}

# -----------------------------------------------------------------------------
# Content Security Policy
#
# Recompute the inline <script> hashes after changing one:
#
# php -r 'foreach (array_slice($argv, 1) as $f) { preg_match_all("#<script>(.*?)</script>#s", file_get_contents($f), $m); foreach ($m[1] as $b) $h[base64_encode(hash("sha256", $b, true))] = 1; } echo implode("\n", array_keys($h)), "\n";' *.html {de,fr,it,es}/*.html docs/api/index.html
#
# /app/ and /api/ are handled separately and therefore receive no CSP header
# from this map.
# -----------------------------------------------------------------------------

map $uri $news_reader_csp {
    default "default-src 'self'; script-src 'self' 'sha256-9lQjb134mvyOB3xes/iDiL6x7sn/Fna2QxvI5oHQJIg=' 'sha256-MKRoizIuCBWDw/RzCTan+DJeB0qXBl/IcfGW4Ce3Ywo=' 'sha256-TnyechigmvCj/lPGufJH0BfroWr22g6Pdlka/0Dv7X0=' https://api.pirsch.io; connect-src 'self' https://api.pirsch.io; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'";
    ~^/app/ "";
    ~^/api/ "";
}

server {
    listen 80;
    listen [::]:80;

    root /home/ploi/news-reader.app/;
    server_name news-reader.app;

    # Ploi manages certificates/HTTPS here.
    include /etc/nginx/ssl/news-reader.app;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ecdh_curve X25519:prime256v1:secp384r1;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384:DHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_dhparam /etc/nginx/dhparams.pem;

    index index.html index.php;

    charset utf-8;
    client_max_body_size 1m;
    server_tokens off;

    # Unknown and blocked addresses get the site's 404 page (see map above);
    # the API answers its own JSON errors (no fastcgi_intercept_errors).
    error_page 404 $news_reader_404;

    # -------------------------------------------------------------------------
    # Security headers
    # -------------------------------------------------------------------------

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Content-Security-Policy $news_reader_csp always;

    # -------------------------------------------------------------------------
    # Compression
    # -------------------------------------------------------------------------

    gzip on;
    gzip_vary on;
    gzip_min_length 512;
    gzip_types
        text/css
        text/plain
        application/javascript
        application/json
        application/xml
        image/svg+xml
        application/manifest+json;

    # -------------------------------------------------------------------------
    # Ploi configuration - do not remove!
    # -------------------------------------------------------------------------

    include /etc/nginx/ploi/news-reader.app/server/*;

    # -------------------------------------------------------------------------
    # Never expose internal/application files
    # -------------------------------------------------------------------------

    location ^~ /.well-known/ {
        try_files $uri =404;
    }

    location ~ ^/(src|var|vendor|tests|tools|gherkin)(/|$) {
        return 404;
    }

    location ~ /\. {
        return 404;
    }

    location ~ \.(conf|md|lock|example|dist|ini|env|log|sql|sqlite|vault|tmp)$ {
        return 404;
    }

    location ~ ^/(composer|package)\.json$ {
        return 404;
    }

    # -------------------------------------------------------------------------
    # API
    #
    # API query strings may contain feed/article URLs.
    # Do not log these requests next to the client IP.
    #
    # All API requests are routed through /api/index.php.
    # No other PHP files may be executed.
    # -------------------------------------------------------------------------

    location = /api {
        return 301 /api/$is_args$args;
    }

    location /api/ {
        access_log off;
        try_files $uri /api/index.php$is_args$args;
    }

    location = /api/index.php {
        access_log off;

        try_files $uri =404;

        fastcgi_pass unix:/run/php/php8.5-fpm.sock;

        include fastcgi_params;

        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;

        fastcgi_read_timeout 120s;

        # Prevent HTTPoxy.
        fastcgi_param HTTP_PROXY "";
    }

    # Absolutely no other PHP scripts may execute.
    location ~ \.php$ {
        return 404;
    }

    # -------------------------------------------------------------------------
    # Static assets
    # -------------------------------------------------------------------------

    location ~* \.(png|jpe?g|webp|avif|gif|ico|svg|woff2?)$ {
        expires 30d;
        access_log off;
        try_files $uri =404;
    }

    location ~* \.(xml|txt|webmanifest)$ {
        expires 1d;
        try_files $uri =404;
    }

    # -------------------------------------------------------------------------
    # Thanks page
    #
    # ?lang=de/fr/it/es is an explicit choice and is never redirected.
    # Without ?lang=..., Accept-Language may select a localized version.
    # -------------------------------------------------------------------------

    location = /thanks.html {
        expires -1;

        if ($news_reader_thanks_lang) {
            return 302 /$news_reader_thanks_lang/thanks.html;
        }

        try_files $uri =404;
    }

    # -------------------------------------------------------------------------
    # Landing page / static application
    # -------------------------------------------------------------------------

    location / {
        expires -1;
        try_files $uri $uri/ =404;
    }

    # -------------------------------------------------------------------------
    # Small standard files
    # -------------------------------------------------------------------------

    location = /favicon.ico {
        access_log off;
        log_not_found off;
        try_files $uri =404;
    }

    location = /robots.txt {
        access_log off;
        log_not_found off;
        try_files $uri =404;
    }

    # -------------------------------------------------------------------------
    # Logging
    # -------------------------------------------------------------------------

    access_log /var/log/nginx/news-reader.app-access.log;
    error_log  /var/log/nginx/news-reader.app-error.log error;
}

# Ploi Webserver Configuration, do not remove!
include /etc/nginx/ploi/news-reader.app/after/*;
