# News Reader – Wharf template. Wharf renders it once per listener (HTTP + HTTPS), so no log_format here (duplicate names are fatal).

# ?lang=… is an explicit choice and never redirected.
map "$arg_lang:$http_accept_language" $news_reader_thanks_lang {
  default "";
  "~^:(?<nr_thanks_lang>de|fr|it|es)" $nr_thanks_lang;
}

# Recompute the inline <script> hashes after changing one:
#   php -r 'foreach (array_slice($argv, 1) as $f) { preg_match_all("#<script>(.*?)</script>#s", file_get_contents($f), $m); foreach ($m[1] as $b) $h[base64_encode(hash("sha256", $b, true))] = 1; } echo implode("\n", array_keys($h)), "\n";' *.html {de,fr,it,es}/*.html docs/api/index.html
map $uri $news_reader_csp {
  default "default-src 'self'; script-src 'self' 'sha256-9lQjb134mvyOB3xes/iDiL6x7sn/Fna2QxvI5oHQJIg=' 'sha256-MKRoizIuCBWDw/RzCTan+DJeB0qXBl/IcfGW4Ce3Ywo=' 'sha256-TnyechigmvCj/lPGufJH0BfroWr22g6Pdlka/0Dv7X0=' https://api.pirsch.io; connect-src 'self' https://api.pirsch.io; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'";
  ~^/app/ "";
  ~^/api/ "";
}

server {
  {{listen}}
  {{ssl}}
  server_name {{server_name}};
  root "{{root}}";
  index index.html index.php;

  access_log "{{log_dir}}/access.log";
  error_log  "{{log_dir}}/error.log";

  charset utf-8;
  client_max_body_size 1m;
  server_tokens off;

  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
  add_header Cross-Origin-Opener-Policy "same-origin" always;
  add_header Content-Security-Policy $news_reader_csp always;

  error_page 404 /404.html;

  gzip on;
  gzip_vary on;
  gzip_min_length 512;
  gzip_types text/css text/plain application/javascript application/json
             application/xml image/svg+xml application/manifest+json;

  location ^~ /.well-known/ { try_files $uri =404; }
  location ~ ^/(src|var|vendor|tests|tools|gherkin)(/|$) { return 404; }
  location ~ /\. { return 404; }
  location ~ \.(conf|md|lock|example|dist|ini|env|log|sql|sqlite|vault|tmp)$ { return 404; }
  location ~ ^/(composer|package)\.json$ { return 404; }

  # API query strings hold feed and article URLs – never log them next to an IP.
  location = /api { return 301 /api/$is_args$args; }
  location /api/ {
    access_log off;
    try_files $uri /api/index.php$is_args$args;
  }

  location = /api/index.php {
    access_log off;
    try_files $uri =404;
    fastcgi_pass {{php}};
    include "{{fastcgi}}";
    fastcgi_param HTTP_PROXY "";  # httpoxy
    fastcgi_read_timeout 120s;
  }
  location ~ \.php$ { return 404; }

  location ~* \.(png|jpe?g|webp|avif|gif|ico|svg|woff2?)$ {
    expires 30d;
    access_log off;
    try_files $uri =404;
  }
  location ~* \.(xml|txt|webmanifest)$ {
    expires 1d;
    try_files $uri =404;
  }
  location = /thanks.html {
    expires -1;
    if ($news_reader_thanks_lang) { return 302 /$news_reader_thanks_lang/thanks.html; }
    try_files $uri =404;
  }
  location / {
    expires -1;
    try_files $uri $uri/ =404;
  }
}
